<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Fixed Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <!-- Menu Button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu_24"
                android:tint="@color/color_primary" />

            <!-- SachsTrack Logo and Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_account_balance_wallet_24"
                    android:tint="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SachsTrack"
                    android:textColor="@color/color_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Add Transaction Button -->
            <ImageButton
                android:id="@+id/btnAddTransaction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add Transaction"
                android:padding="12dp"
                android:src="@drawable/ic_add_24"
                android:tint="@color/color_primary" />

        </LinearLayout>
        <!-- Month Navigation -->
        <LinearLayout
            android:id="@+id/monthNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/btnPreviousMonth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous month"
                android:src="@drawable/ic_chevron_left_24"
                android:tint="@color/color_on_surface_variant" />

            <TextView
                android:id="@+id/tvCurrentMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SEPTEMBER 2026"
                android:textColor="@color/color_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="monospace" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next month"
                android:src="@drawable/ic_chevron_right_24"
                android:tint="@color/color_on_surface_variant" />

        </LinearLayout>
        <!-- Financial Summary Cards -->
        <LinearLayout
            android:id="@+id/summaryCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Income Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="140dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Income"
                        android:textSize="14sp"
                        android:textColor="@color/color_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_income"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:gravity="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <!-- Expense Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:minWidth="140dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expense"
                        android:textSize="14sp"
                        android:textColor="@color/color_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvTotalExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_expense"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:gravity="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <!-- Balance Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minWidth="140dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance"
                        android:textSize="14sp"
                        android:textColor="@color/color_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvTotalBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:gravity="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

    <!-- Analysis Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:background="@color/color_surface_container"
        android:padding="4dp"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnExpenseAnalysis"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Expenses"
            android:textSize="14sp"
            android:textColor="@color/color_on_primary"
            android:background="@color/color_primary"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnIncomeAnalysis"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Income"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface_variant"
            android:background="@color/color_surface_container"
            android:layout_marginHorizontal="2dp" />

        <Button
            android:id="@+id/btnAccountAnalysis"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Accounts"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface_variant"
            android:background="@color/color_surface_container"
            android:layout_marginStart="2dp" />

    </LinearLayout>
    <!-- Scrollable Analysis Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Expense Analysis Content -->
            <LinearLayout
                android:id="@+id/expenseAnalysisContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

            <!-- Pie Chart Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/pieChartCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expense Breakdown"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface"
                        android:layout_marginBottom="8dp" />

                    <!-- Horizontal layout for pie chart and legend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <!-- Pie Chart -->
                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChart"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2.2"
                            android:layout_marginStart="-10dp"
                            android:layout_marginTop="-15dp" />

                    <!-- Legend on the right side with optimized layout -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPieChartLegend"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:scrollbars="vertical"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:overScrollMode="ifContentScrolls" />

                        <!-- Empty State for Pie Chart -->
                        <LinearLayout
                            android:id="@+id/pieChartEmptyState"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3.2"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No expense data"
                                android:textSize="16sp"
                                android:textColor="@color/color_on_surface_variant"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add some transactions to see breakdown"
                                android:textSize="14sp"
                                android:textColor="@color/color_on_surface_variant"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>
                    <!-- Click instruction text -->
                    <TextView
                        android:id="@+id/tvClickInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap segments to show transactions below"
                        android:textSize="12sp"
                        android:textColor="@color/color_on_surface_variant"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Selected Category Spending Details Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/selectedCategoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <!-- Selected Category Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Category Icon -->
                        <LinearLayout
                            android:id="@+id/selectedCategoryIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="@color/color_surface_container_high"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivSelectedCategoryIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Category Icon"
                                app:tint="@color/color_primary"
                                android:src="@drawable/ic_receipt_24" />

                        </LinearLayout>

                        <!-- Category Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvSelectedCategoryName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Category Name"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_on_surface" />

                            <TextView
                                android:id="@+id/tvSelectedCategoryPercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0% of total expenses"
                                android:textSize="14sp"
                                android:textColor="@color/color_on_surface_variant"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>
                        <!-- Amount -->
                        <TextView
                            android:id="@+id/tvSelectedCategoryAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_expense"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressSelectedCategory"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="8dp"
                        android:progressTint="@color/color_expense"
                        android:progressBackgroundTint="@color/color_surface_container"
                        android:progress="50" />

                    <!-- Transaction Count -->
                    <TextView
                        android:id="@+id/tvTransactionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 transactions this month"
                        android:textSize="12sp"
                        android:textColor="@color/color_on_surface_variant"
                        android:layout_gravity="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <!-- Category Breakdown List -->
            <androidx.cardview.widget.CardView
                android:id="@+id/categoryListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:minHeight="200dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCategoryBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:scrollbars="vertical"
                        android:clipToPadding="false"
                        android:overScrollMode="ifContentScrolls" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/categoryEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minHeight="120dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No transactions yet"
                            android:textSize="16sp"
                            android:textColor="@color/color_on_surface_variant"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start adding transactions to see analysis"
                            android:textSize="14sp"
                            android:textColor="@color/color_on_surface_variant"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Income Analysis Content -->
            <LinearLayout
                android:id="@+id/incomeAnalysisContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="300dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Income Breakdown"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_surface"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Income analysis by source - Coming Soon"
                            android:textSize="16sp"
                            android:textColor="@color/color_on_surface_variant"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginTop="100dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Account Analysis Content -->
            <LinearLayout
                android:id="@+id/accountAnalysisContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:minHeight="300dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account Breakdown"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_surface"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account balance analysis - Coming Soon"
                            android:textSize="16sp"
                            android:textColor="@color/color_on_surface_variant"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginTop="100dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>