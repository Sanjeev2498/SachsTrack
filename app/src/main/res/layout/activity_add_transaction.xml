<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="12dp"
            android:src="@drawable/ic_close_24"
            android:tint="@color/color_on_surface" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New Transaction"
            android:textColor="@color/color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="@color/color_primary"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Transaction Type Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_segmented_control"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_income"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transaction_type_selector"
            android:text="Income"
            android:textAllCaps="false"
            android:textColor="@color/transaction_type_text_selector" />

        <Button
            android:id="@+id/btn_expense"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transaction_type_selector"
            android:text="Expense"
            android:textAllCaps="false"
            android:textColor="@color/transaction_type_text_selector" />

        <Button
            android:id="@+id/btn_transfer"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transaction_type_selector"
            android:text="Transfer"
            android:textAllCaps="false"
            android:textColor="@color/transaction_type_text_selector" />

    </LinearLayout>

    <!-- Middle Section: Account, Category, Notes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- Account and Category Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Account Selector -->
            <LinearLayout
                android:id="@+id/layout_account_selector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_selector_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_selected_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableEnd="@drawable/ic_keyboard_arrow_down_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/color_on_surface_variant"
                    android:text="Select Account"
                    android:textColor="@color/color_on_surface"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Category Selector -->
            <LinearLayout
                android:id="@+id/layout_category_selector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_selector_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_selected_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableEnd="@drawable/ic_keyboard_arrow_down_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/color_on_surface_variant"
                    android:text="Select Category"
                    android:textColor="@color/color_on_surface"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Notes Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_selector_button"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:hint="Add a note (optional)"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:minLines="2"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_on_surface_variant"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Calculator Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Amount Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/tv_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:text="Rs"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_amount_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="0"
                android:textColor="@color/color_on_surface"
                android:textSize="42sp" />

        </LinearLayout>

        <!-- Calculator Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:columnCount="4"
            android:rowCount="5">

            <!-- Row 1: C, ÷, ×, ⌫ -->
            <Button
                android:id="@+id/btn_clear"
                style="@style/CalculatorButton.Operator"
                android:layout_columnWeight="1"
                android:text="C" />

            <Button
                android:id="@+id/btn_divide"
                style="@style/CalculatorButton.Operator"
                android:layout_columnWeight="1"
                android:text="÷" />

            <Button
                android:id="@+id/btn_multiply"
                style="@style/CalculatorButton.Operator"
                android:layout_columnWeight="1"
                android:text="×" />

            <Button
                android:id="@+id/btn_backspace"
                style="@style/CalculatorButton.Operator"
                android:layout_columnWeight="1"
                android:text="⌫" />

            <!-- Row 2: 7, 8, 9, - -->
            <Button
                android:id="@+id/btn_7"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="7" />

            <Button
                android:id="@+id/btn_8"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="8" />

            <Button
                android:id="@+id/btn_9"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="9" />

            <Button
                android:id="@+id/btn_subtract"
                style="@style/CalculatorButton.Operator"
                android:layout_columnWeight="1"
                android:text="−" />

            <!-- Row 3: 4, 5, 6, + -->
            <Button
                android:id="@+id/btn_4"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="4" />

            <Button
                android:id="@+id/btn_5"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="5" />

            <Button
                android:id="@+id/btn_6"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="6" />

            <Button
                android:id="@+id/btn_add"
                style="@style/CalculatorButton.Operator"
                android:layout_columnWeight="1"
                android:text="+" />

            <!-- Row 4: 1, 2, 3, = (spans 2 rows) -->
            <Button
                android:id="@+id/btn_1"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="1" />

            <Button
                android:id="@+id/btn_2"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="2" />

            <Button
                android:id="@+id/btn_3"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="3" />

            <Button
                android:id="@+id/btn_equals"
                style="@style/CalculatorButton.Equals"
                android:layout_rowSpan="2"
                android:layout_columnWeight="1"
                android:text="=" />

            <!-- Row 5: 0 (spans 2 columns), . -->
            <Button
                android:id="@+id/btn_0"
                style="@style/CalculatorButton"
                android:layout_columnSpan="2"
                android:layout_columnWeight="2"
                android:text="0" />

            <Button
                android:id="@+id/btn_decimal"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:text="." />

        </GridLayout>

    </LinearLayout>

    <!-- Date and Time Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/layout_date_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_calendar_today_24"
                android:tint="@color/color_on_surface_variant" />

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="14sp" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/color_outline_variant" />

        <LinearLayout
            android:id="@+id/layout_time_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_access_time_24"
                android:tint="@color/color_on_surface_variant" />

            <TextView
                android:id="@+id/tv_selected_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>