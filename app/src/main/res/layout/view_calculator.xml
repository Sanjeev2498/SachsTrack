<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface_container"
    android:orientation="vertical">

    <!-- Calculator Grid -->
    <GridLayout
        android:id="@+id/calculator_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:background="@color/color_surface_container">

        <!-- Row 1: C, ÷, ×, ⌫ -->
        <Button
            android:id="@+id/btn_clear"
            style="@style/Widget.SachsTrack.Calculator.Button.Operator"
            android:layout_columnWeight="1"
            android:text="@string/calc_clear" />

        <Button
            android:id="@+id/btn_divide"
            style="@style/Widget.SachsTrack.Calculator.Button.Operator"
            android:layout_columnWeight="1"
            android:text="@string/calc_divide" />

        <Button
            android:id="@+id/btn_multiply"
            style="@style/Widget.SachsTrack.Calculator.Button.Operator"
            android:layout_columnWeight="1"
            android:text="@string/calc_multiply" />

        <Button
            android:id="@+id/btn_backspace"
            style="@style/Widget.SachsTrack.Calculator.Button.Operator"
            android:layout_columnWeight="1"
            app:icon="@drawable/ic_backspace_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <!-- Row 2: 7, 8, 9, - -->
        <Button
            android:id="@+id/btn_7"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="7" />

        <Button
            android:id="@+id/btn_8"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="8" />

        <Button
            android:id="@+id/btn_9"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="9" />

        <Button
            android:id="@+id/btn_subtract"
            style="@style/Widget.SachsTrack.Calculator.Button.Operator"
            android:layout_columnWeight="1"
            android:text="@string/calc_subtract" />

        <!-- Row 3: 4, 5, 6, + -->
        <Button
            android:id="@+id/btn_4"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="4" />

        <Button
            android:id="@+id/btn_5"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="5" />

        <Button
            android:id="@+id/btn_6"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="6" />

        <Button
            android:id="@+id/btn_add"
            style="@style/Widget.SachsTrack.Calculator.Button.Operator"
            android:layout_columnWeight="1"
            android:text="@string/calc_add" />

        <!-- Row 4: 1, 2, 3, = (spans 2 rows) -->
        <Button
            android:id="@+id/btn_1"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="1" />

        <Button
            android:id="@+id/btn_2"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="2" />

        <Button
            android:id="@+id/btn_3"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="3" />

        <Button
            android:id="@+id/btn_equals"
            style="@style/Widget.SachsTrack.Calculator.Button.Equals"
            android:layout_rowSpan="2"
            android:layout_columnWeight="1"
            android:text="@string/calc_equals" />

        <!-- Row 5: 0 (spans 2 columns), . -->
        <Button
            android:id="@+id/btn_0"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:text="0" />

        <Button
            android:id="@+id/btn_decimal"
            style="@style/Widget.SachsTrack.Calculator.Button"
            android:layout_columnWeight="1"
            android:text="@string/calc_decimal" />

    </GridLayout>

</LinearLayout>